{
  "name": "bbsachieve-frontend",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "db:up": "docker compose -f docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:logs": "docker compose -f docker-compose.dev.yml logs -f postgres",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "dev:setup": "pnpm db:up && pnpm --filter @bbs/web exec tsx src/modules/mirroring/dev/setup.ts",
    "dev:local": "pnpm --filter @bbs/web exec next dev --webpack --hostname 127.0.0.1 --port 3307",
    "mirror:tick": "pnpm --filter @bbs/web exec tsx src/modules/mirroring/dev/cli.ts tick",
    "mirror:probe": "pnpm --filter @bbs/web exec tsx src/modules/mirroring/dev/cli.ts probe",
    "mirror:test": "pnpm --filter @bbs/web exec vitest run tests/mirroring tests/private-access.test.ts && pnpm --filter @bbs/web exec tsx src/modules/mirroring/dev/integration.ts",
    "ui:test": "pnpm --filter @bbs/web exec playwright test"
  },
  "pnpm": {
    "overrides": {
      "@kinde/expo>expo-auth-session": "~56.0.11",
      "@kinde/expo>expo-crypto": "~56.0.3",
      "@kinde/expo>expo-linking": "~56.0.11",
      "@kinde/expo>expo-secure-store": "~56.0.4",
      "@kinde/expo>expo-web-browser": "~56.0.5",
      "react-test-renderer": "19.2.3"
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
